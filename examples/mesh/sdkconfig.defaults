CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# The mesh interface reuses the AP-type vif and the BSS_CONFIG / beacon code path,
# so the AP-mode morselib sources have to be compiled in even though this example
# never runs a SoftAP.
CONFIG_HALOW_AP_MODE=y

CONFIG_FREERTOS_HZ=1000
