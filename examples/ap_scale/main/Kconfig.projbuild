menu "High-density AP example configuration"

config EXAMPLE_WIFI_SSID
	string "Wi-Fi SSID"
	default "MorseMicroESP32AP"

config EXAMPLE_WIFI_PSK
	string "Wi-Fi passphrase"
	default "12345678"
	help
	    At least 8 characters — required for SAE.

config EXAMPLE_S1G_CHANNEL
	int "S1G channel"
	default 27

config EXAMPLE_S1G_OPCLASS
	int "S1G operating class"
	default 68

config EXAMPLE_AP_IPV4
	string "SoftAP static IPv4 address"
	default "192.168.12.1"
	help
	    The AP runs no DHCP server, so it pins a static address and each station
	    does the same.

config EXAMPLE_AP_MAX_STAS
	int "Stations this AP will admit"
	default 255
	range 1 255
	help
	    Runtime station ceiling, passed as mmwlan_ap_args.max_stas.

	    This must not exceed CONFIG_HALOW_AP_MAX_STAS, which is the compile-time
	    ceiling the per-STA tables are sized to (set to 255 in this example's
	    sdkconfig.defaults). Raising this alone does not enlarge the tables.

config EXAMPLE_REPORT_INTERVAL_S
	int "Station-count report interval (seconds)"
	default 10
	help
	    How often to log the associated-station count and remaining heap, so the
	    memory cost per station is visible as the AP fills up.

endmenu
