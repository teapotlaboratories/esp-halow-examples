# SPDX-License-Identifier: Apache-2.0

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# An IBSS interface reuses the AP-type vif and the beacon code path, so the AP-mode
# morselib sources have to be compiled in even though this example runs no SoftAP.
CONFIG_HALOW_AP_MODE=y

CONFIG_FREERTOS_HZ=1000
